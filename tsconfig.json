{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "reelkit-theme": [
        "src/theme.default.ts"
      ],
      "reelkit-elements": [
        "src/elements.default.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
